<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <name>Namazu Cloud Connect</name>
  <description>Namazu Cloud Connect, the client connector for Namazu Cloud: an open-source Elements element that connects outbound to the Namazu Cloud control plane over a mutually-authenticated WebSocket channel.</description>
  <url>https://github.com/NamazuStudios/namazu-cloud-client</url>

  <licenses>
    <license>
      <name>Mozilla Public License Version 2.0</name>
      <url>https://www.mozilla.org/MPL/2.0/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Patrick Twohig</name>
      <email>patrick@namazustudios.com</email>
      <organization>Namazu Studios LLC</organization>
      <organizationUrl>https://namazustudios.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/NamazuStudios/namazu-cloud-client</url>
    <connection>scm:git:https://github.com/NamazuStudios/namazu-cloud-client.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/NamazuStudios/namazu-cloud-client.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <modelVersion>4.0.0</modelVersion>
  <groupId>com.namazustudios.cloud</groupId>
  <artifactId>cloud-client</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <encoding>UTF-8</encoding>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <kotlin.version>2.1.0</kotlin.version>
    <guice.version>7.0.0</guice.version>
    <elements.version>3.9.0-rc-9</elements.version>
    <!--
      Compile-time only: both are `provided` at runtime, supplied by the platform's mongo element.
      Pinned explicitly because the Elements BOM does not manage them.
    -->
    <morphia.version>2.4.14</morphia.version>
    <mongodb.version>4.10.2</mongodb.version>
    <junit.version>5.10.2</junit.version>
    <dokka.version>2.0.0</dokka.version>
    <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm:ss'Z'</maven.build.timestamp.format>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!--
        Source jars for every published module. Maven Central requires them. The `ui` module
        (pom packaging) opts out in its own pom since it carries no Java/Kotlin sources.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>prepare-package</phase>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!--
        Javadoc jars via Dokka (supports Kotlin sources natively). Maven Central requires a
        non-empty javadoc artifact for every published jar.
      -->
      <plugin>
        <groupId>org.jetbrains.dokka</groupId>
        <artifactId>dokka-maven-plugin</artifactId>
        <version>${dokka.version}</version>
        <configuration>
          <sourceDirectories>
            <dir>${project.basedir}/src/main/kotlin</dir>
          </sourceDirectories>
        </configuration>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals><goal>javadocJar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        The BOM for Namazu Elements incorporates all the official SDK packages with correct
        version and scope. Importing it means Element dependencies never carry explicit versions.
      -->
      <dependency>
        <groupId>dev.getelements.elements</groupId>
        <artifactId>sdk-bom</artifactId>
        <version>${elements.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        The shared control-plane protocol artifact. Compiled as a plain jar and bundled into the
        .elm's lib/ directory (never exported to the platform's shared API classpath).
      -->
      <dependency>
        <groupId>com.namazustudios.cloud</groupId>
        <artifactId>cloud-client-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <!--
      Must build before `element` - it writes plugin.bundle.js directly into
      element/src/main/ui/superuser/, which element's package phase then stages into the .elm
      (see the elm-stage-static-content execution in element/pom.xml).
    -->
    <module>ui</module>
    <module>api</module>
    <module>element</module>
    <module>mock</module>
    <module>debug</module>
  </modules>

  <profiles>
    <!--
      Publishes release artifacts to Maven Central. Activated only by the release workflow
      (`mvn -Pcentral-publish clean deploy`); requires the CENTRAL_USERNAME/CENTRAL_PASSWORD
      server credentials and GPG signing material provided by actions/setup-java.
    -->
    <profile>
      <id>central-publish</id>
      <build>
        <plugins>
          <!-- Central Publishing Plugin -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <waitMaxTime>3600</waitMaxTime>
            </configuration>
          </plugin>
          <!-- GPG Plugin (Required for Maven Central) -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!--
      Publishes artifacts to GitHub Packages. Activated by the snapshot-publish workflow. Releases
      and snapshots both land here; Maven routes each by version.
    -->
    <profile>
      <id>github-publish</id>
      <distributionManagement>
        <repository>
          <id>github</id>
          <url>https://maven.pkg.github.com/NamazuStudios/namazu-cloud-client</url>
        </repository>
        <snapshotRepository>
          <id>github</id>
          <url>https://maven.pkg.github.com/NamazuStudios/namazu-cloud-client</url>
        </snapshotRepository>
      </distributionManagement>
    </profile>
  </profiles>

</project>